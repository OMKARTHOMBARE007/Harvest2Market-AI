# Copy this file to .env and edit the values below.
# Never commit your real .env to version control.

# A long random secret for signing JWT tokens.
# Change this before any deployment!
SECRET_KEY=replace-this-with-a-long-random-secret

# How many minutes a login token stays valid (default: 60 minutes)
ACCESS_TOKEN_MINUTES=60

# SQLite database location. The default stores it in the backend folder.
DATABASE_URL=sqlite:///./harvest2market.db

# Origins allowed to send requests to the API.
# Add the exact URL (including port) that your frontend runs on.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
